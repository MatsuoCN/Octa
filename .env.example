# Fonte dos dados: "mock" usa src/lib/mockData.ts, "api" usa o backend.
NEXT_PUBLIC_DATA_SOURCE=mock

# URL base do backend (usada quando NEXT_PUBLIC_DATA_SOURCE=api).
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# Atraso artificial no modo mock, em milissegundos, para testar estados de carregamento.
NEXT_PUBLIC_MOCK_DELAY_MS=0
